# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
ADMIN_CHAT_IDS=123456789,987654321

# Server & Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crypto_p2p_bot
PORT=8000

# GoPay / Gopiz Gateway (lokal)
GOPAY_GATEWAY_URL=http://127.0.0.1:3000
GOPAY_API_KEY=RAHASIA

# EVM Wallets (BSC, ETH, AVAX, MATIC, BASE, ARB, Gravity)
EVM_PRIVATE_KEY=your_evm_private_key_here
EVM_WALLET_ADDRESS=your_evm_public_address_here

# RPC Endpoints
BSC_RPC=https://bsc-dataseed.binance.org/
ETH_RPC=https://cloudflare-eth.com
AVAX_RPC=https://api.avax.network/ext/bc/C/rpc
POLYGON_RPC=https://polygon-rpc.com
BASE_RPC=https://mainnet.base.org
ARB_RPC=https://arb1.arbitrum.io/rpc
GRAVITY_RPC=https://rpc.gravity.xyz

# Non-EVM Wallets
SOL_PRIVATE_KEY=your_solana_private_key_base58_here
SOL_WALLET_ADDRESS=your_solana_public_address_here

TRX_PRIVATE_KEY=your_tron_private_key_here
TRX_WALLET_ADDRESS=your_tron_public_address_here

TON_PRIVATE_KEY=your_ton_wallet_mnemonic_24_words_here
TON_WALLET_ADDRESS=your_ton_public_address_here

# General Configurations
ORDER_EXPIRE_MINUTES=30
DEFAULT_SPREAD_PCT=1.5
